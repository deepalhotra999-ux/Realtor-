# ────────────────────────────────────────────────────────────────────────────
# Dwellwise environment configuration
#
# EVERY value below is optional. With no .env file at all the app runs against
# a local Postgres + PostGIS database using free/local/mock providers only.
# No paid API keys are required — ever — to run, develop, or launch in free mode.
# ────────────────────────────────────────────────────────────────────────────

# Core
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dwellwise
APP_URL=http://localhost:3000
# Used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-in-production

# ── AI ─────────────────────────────────────────────────────────────────────
# auto   = use Ollama when reachable, otherwise the deterministic mock provider
# ollama = always use Ollama (errors fall back to mock)
# mock   = never call a model (fully offline, deterministic)
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Maps & geocoding ───────────────────────────────────────────────────────
# Any XYZ raster tile server. Default is the OpenStreetMap community server —
# respect its usage policy (https://operations.osmfoundation.org/policies/tiles/)
# and self-host tiles for production traffic.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# local     = offline gazetteer + database lookups (default, no network)
# nominatim = OpenStreetMap Nominatim (public or self-hosted)
GEOCODING_PROVIDER=local
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Dwellwise/0.1 (self-hosted)

# ── Storage ────────────────────────────────────────────────────────────────
# local = ./storage/uploads served by the app, s3 = MinIO / any S3-compatible store
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dwellwise
S3_PUBLIC_URL=http://localhost:9000/dwellwise

# ── Email & SMS ────────────────────────────────────────────────────────────
# outbox = stored in the database + logged to console (view in Admin → Notifications)
# smtp   = any SMTP server (e.g. Mailpit from docker-compose on :1025, free)
EMAIL_PROVIDER=outbox
EMAIL_FROM=Dwellwise <no-reply@dwellwise.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=outbox

# ── Search ─────────────────────────────────────────────────────────────────
# postgres = PostgreSQL full-text + PostGIS (default)
SEARCH_PROVIDER=postgres

# ── Property data ──────────────────────────────────────────────────────────
# seed = fictional demo data. reso = RESO Web API adapter (requires your own feed access)
PROPERTY_DATA_PROVIDER=seed
RESO_BASE_URL=
RESO_ACCESS_TOKEN=

# ── Payments ───────────────────────────────────────────────────────────────
# mock = local simulated checkout (no money moves). Add a real adapter later.
PAYMENT_PROVIDER=mock
