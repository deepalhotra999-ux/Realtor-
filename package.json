{
  "name": "dwellwise",
  "version": "0.1.0",
  "private": true,
  "description": "Dwellwise — an open, free-first real-estate marketplace platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:studio": "drizzle-kit studio",
    "setup": "pnpm db:migrate && pnpm db:seed",
    "worker": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/worker.ts",
    "test:int": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@netlify/blobs": "^11.1.1",
    "@netlify/neon": "^0.1.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "minio": "^8.0.7",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.33.0"
}
